rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // MED System usa Firebase SOLO per gli account di accesso.
    // Pazienti, visite, appuntamenti, allegati, registro attività e archivio
    // email vivono esclusivamente nel database interno del PC (app desktop)
    // o del browser. Gli account si gestiscono dal portale dell'amministratore
    // tramite la Cloud Function "portaleUtenti" (Admin SDK).
    // ═══════════════════════════════════════════════════════════

    // ── UTENTI: profilo dell'account (nome, genere, tema, stato) ──
    // - ognuno legge solo il proprio profilo; l'amministratore li legge tutti
    // - nessuno può crearsi un profilo da solo: senza profilo l'app nega
    //   l'accesso, quindi entra solo chi è stato creato dal portale
    // - ognuno aggiorna solo campi innocui del proprio profilo (mai 'attivo')
    match /utenti/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.email == 'titancodesm@gmail.com');
      allow create: if request.auth != null && request.auth.token.email == 'titancodesm@gmail.com';
      allow update: if request.auth != null
        && (request.auth.token.email == 'titancodesm@gmail.com'
            || (request.auth.uid == uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAccesso','mustChangePassword','genere','tema','sezioniPersonalizzate'])));
      allow delete: if request.auth != null && request.auth.token.email == 'titancodesm@gmail.com';
    }

    // ── Pacchetto studio: testi propri del medico (frasi, consensi, schemi),
    //    mai dati di pazienti. Il medico lo legge; lo scrive solo il portale
    //    (Admin SDK). Le versioni precedenti restano riservate al portale.
    match /pacchetti/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ── Modello mostrato dal sito dimostrativo (nessun dato personale) ──
    // Lo legge chiunque apra il sito demo; lo cambia solo il portale (Admin SDK).
    match /config/demo {
      allow read: if true;
    }

    // ── Tutto il resto: bloccato ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
