{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MED System Gineco",
  "version": "1.8.0",
  "identifier": "it.medsystem.gineco",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MED System Gineco",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MED System",
    "shortDescription": "MED System Gineco — gestione studio ginecologico",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMzY3NEE2QTJGREQzQjMKUldTejAvMmlwblEyNGR1M2xWcnRNVzdYOHJuZkNnMjh0SCtKQitTZWM5OGdDOU00R0hBS2xTQWQK",
      "endpoints": [
        "https://github.com/titan-code-sm/gynosistem/releases/latest/download/latest-gineco.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
