{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MED System Gineco",
  "version": "1.6.4",
  "identifier": "it.medsystem.gineco",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MED System Gineco",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MED System",
    "shortDescription": "MED System Gineco — gestione studio ginecologico",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ]
      }
    }
  }
}
