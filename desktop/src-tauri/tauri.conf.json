{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GynoSystem",
  "version": "1.0.0",
  "identifier": "it.drssaguidi.gynosystem",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GynoSystem",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Studio Dr.ssa Cristina Guidi",
    "shortDescription": "Gestione studio ginecologico",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"]
      }
    }
  }
}
